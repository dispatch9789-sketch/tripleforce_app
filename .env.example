# ═══════════════════════════════════════════════════════════
# Triple Force Logistic LLC — Environment Variables
# Copy this file to ".env" and fill in your values.
# Never commit the real .env file to version control.
# ═══════════════════════════════════════════════════════════

# ── Flask Secret Key ──
# Generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# ── Database ──
# SQLite (default — works out of the box):
DATABASE_URL=sqlite:///tripleforce.db
# To upgrade to PostgreSQL later, uncomment and set:
# DATABASE_URL=postgresql://user:password@localhost:5432/tripleforce

# ── Mail Server (SMTP) ──
# Used for sending quotes, invoices, and notifications.
# Gmail example: MAIL_SERVER=smtp.gmail.com, MAIL_PORT=587, MAIL_USE_TLS=True
# Use an App Password, NOT your regular Gmail password.
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=dispatch@tripleforcelogistic.com
MAIL_PASSWORD=your-app-password-here
MAIL_DEFAULT_SENDER=dispatch@tripleforcelogistic.com

# ── Application ──
FLASK_ENV=development
FLASK_DEBUG=1
# Set to 0.0.0.0 to allow access from other devices on your network (iPhone, tablet)
HOST=0.0.0.0
PORT=5000

# ── Upload Settings ──
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/static/uploads

# ═══════════════════════════════════════════════════════════
# PRODUCTION DEPLOYMENT VARIABLES
# Set these in your hosting platform's dashboard (Render, Railway, Fly.io, etc.)
# ═══════════════════════════════════════════════════════════

# ── Production Flask ──
# FLASK_ENV=production
# FLASK_DEBUG=0

# ── Production Database (PostgreSQL) ──
# Set DATABASE_URL to your managed PostgreSQL connection string:
# DATABASE_URL=postgresql://user:password@host:5432/tripleforce

# ── Render.com: Set all above in Dashboard → Environment ──
# ── Railway:     Set in Settings → Variables ──
# ── Fly.io:      Use `fly secrets set KEY=value` ──
# ── DigitalOcean App Platform: Set in Components → Environment ──
